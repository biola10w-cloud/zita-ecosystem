# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=https://api.zita.app
CORS_ORIGINS=https://zita.app,https://admin.zita.app

# Database
DATABASE_URL=postgresql://zita:password@localhost:5432/zita_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Alternatively set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY to inline PEM values.
# Store literal newlines as \n when entering these values in a host dashboard.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS / Cloudflare R2
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=zita-books
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com  # R2 endpoint

# AWS KMS (envelope encryption master key)
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789:key/your-key-id
KMS_ENCRYPTION_ALGORITHM=SYMMETRIC_DEFAULT

# Apple IAP
APPLE_SHARED_SECRET=your_apple_shared_secret
APPLE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
APPLE_SANDBOX_VERIFY_URL=https://sandbox.itunes.apple.com/verifyReceipt

# Google IAP
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./keys/google-service-account.json
GOOGLE_PACKAGE_NAME=com.zita.app

# Web subscriptions (required before enabling Stripe checkout)
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Transactional email (required for production password-reset emails)
SENDGRID_API_KEY=SG.replace_me
EMAIL_FROM_ADDRESS=no-reply@zita.app

# Operations and delivery (recommended for production)
SENTRY_DSN=https://replace_me@sentry.io/project
CDN_BASE_URL=https://cdn.zita.app

# Encryption
BOOK_ENCRYPTION_ALGORITHM=aes-256-gcm
