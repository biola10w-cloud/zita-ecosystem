    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.9.1",
    "@sendgrid/mail": "^8.1.4",
    "@sentry/node": "^8.47.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "dotenv": "^17.4.2",
    "fastify": "^4.26.2",
    "firebase-admin": "^13.0.2",
