# ─── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.yourdomain.com

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://zita:CHANGE_THIS_PASSWORD@localhost:5432/zita_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@localhost:6379

# ─── JWT (RS256 — generate with: npm run keys:generate) ───────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── AWS / Cloudflare R2 ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=zita-books
# For Cloudflare R2 only — leave blank for AWS S3
S3_ENDPOINT=

# ─── AWS KMS (book encryption master key) ─────────────────────
KMS_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT_ID:key/YOUR-KEY-ID

# ─── Apple In-App Purchase ────────────────────────────────────
APPLE_SHARED_SECRET=your_apple_shared_secret
APPLE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
APPLE_SANDBOX_VERIFY_URL=https://sandbox.itunes.apple.com/verifyReceipt

# ─── Google Play In-App Purchase ──────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./keys/google-service-account.json
GOOGLE_PACKAGE_NAME=com.zita.app

# ─── Google Cloud Translation ─────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# ─── Watermarking ─────────────────────────────────────────────
WATERMARK_SECRET=generate_a_random_64_char_string_here
